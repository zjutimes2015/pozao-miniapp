.page {
  min-height: 100vh;
  background: #FCFCFA;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 44rpx;
  color: #1C1C1A;
}

.stats-card {
  display: flex;
  background: #F4F3EF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  color: #1C1C1A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8B8A85;
}

.info-block {
  margin-bottom: 40rpx;
}

.info-title {
  font-size: 28rpx;
  color: #1C1C1A;
  display: block;
  margin-bottom: 16rpx;
}

.info-text {
  font-size: 26rpx;
  color: #5F5E5A;
  line-height: 1.7;
  display: block;
  margin-bottom: 16rpx;
}

.disclaimer-block {
  background: #FAEEDA;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
}

.disclaimer-label {
  font-size: 22rpx;
  color: #854F0B;
  display: block;
  margin-bottom: 10rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #854F0B;
  line-height: 1.6;
}

.menu {
  margin-bottom: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(28, 28, 26, 0.1);
}

.menu-text {
  font-size: 28rpx;
  color: #1C1C1A;
}

.menu-text-danger {
  color: #A32D2D;
}

.menu-arrow {
  font-size: 32rpx;
  color: #B4B2A9;
}

.review-note {
  background: #F4F3EF;
  border-radius: 12rpx;
  padding: 24rpx;
}

.review-text {
  font-size: 22rpx;
  color: #5F5E5A;
  line-height: 1.7;
}