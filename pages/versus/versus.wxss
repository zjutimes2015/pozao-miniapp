.page {
  min-height: 100vh;
  background: #FCFCFA;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.state-box {
  padding-top: 96rpx;
}

.state-title {
  font-size: 40rpx;
  color: #1C1C1A;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.state-desc {
  font-size: 28rpx;
  color: #5F5E5A;
  line-height: 1.7;
  display: block;
  margin-bottom: 16rpx;
}

.state-desc-strong {
  color: #1C1C1A;
}

.state-room {
  font-size: 48rpx;
  color: #1C1C1A;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.btn-primary {
  background: #1C1C1A;
  color: #FCFCFA;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
  width: 100%;
  border: none;
  margin-top: 48rpx;
}

.btn-disabled {
  opacity: 0.3;
}

.btn-secondary {
  background: transparent;
  color: #1C1C1A;
  border: 1rpx solid rgba(28, 28, 26, 0.2);
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
  width: 100%;
  margin-top: 32rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #8B8A85;
}

.progress-status {
  font-size: 24rpx;
  color: #1C1C1A;
}

.text-block {
  font-size: 34rpx;
  line-height: 1.6;
  color: #1C1C1A;
  margin-bottom: 40rpx;
}

.cards {
  margin-bottom: 40rpx;
}

.card {
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-active {
  border-color: #185FA5;
  background: #E6F1FB;
}

.card-type {
  font-size: 20rpx;
  color: #8B8A85;
  margin-bottom: 8rpx;
}

.card-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.5;
}

.merge-status {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.merge-item {
  flex: 1;
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 22rpx;
  color: #8B8A85;
  text-align: center;
}

.merge-done {
  border-color: #0F6E56;
  background: #E1F5EE;
  color: #0F6E56;
}

.merge-tip {
  font-size: 22rpx;
  color: #8B8A85;
  margin-bottom: 24rpx;
}

.result-block {
  background: #F4F3EF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 32rpx 0;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-label {
  font-size: 28rpx;
  color: #5F5E5A;
}

.result-value {
  font-size: 28rpx;
}

.val-right {
  color: #0F6E56;
}

.val-miss {
  color: #B4B2A9;
}

.truth {
  border-left: 3rpx solid #185FA5;
  padding-left: 24rpx;
  margin-bottom: 48rpx;
}

.truth-label {
  font-size: 22rpx;
  color: #8B8A85;
  margin-bottom: 10rpx;
}

.truth-text {
  font-size: 26rpx;
  color: #1C1C1A;
  line-height: 1.6;
}

.truth-body {
  margin-top: 12rpx;
  color: #5F5E5A;
}