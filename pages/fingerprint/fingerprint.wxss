.page {
  min-height: 100vh;
  background: #FCFCFA;
  padding: 48rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 44rpx;
  color: #1C1C1A;
  display: block;
  margin-bottom: 16rpx;
}

.code-box {
  display: inline-block;
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
}

.code {
  font-size: 26rpx;
  color: #1C1C1A;
  letter-spacing: 1rpx;
}

.sample-note {
  background: #FAEEDA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #854F0B;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 26rpx;
  color: #5F5E5A;
  display: block;
  margin-bottom: 24rpx;
}

/* 分组表现卡片 */
.group-item {
  background: #F4F3EF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.group-name {
  font-size: 30rpx;
  color: #1C1C1A;
}

.group-conf {
  font-size: 20rpx;
  color: #8B8A85;
}

.group-desc {
  font-size: 22rpx;
  color: #8B8A85;
  margin-bottom: 20rpx;
}

.group-bars {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bar-line {
  display: flex;
  align-items: center;
}

.bar-label {
  font-size: 22rpx;
  color: #5F5E5A;
  width: 110rpx;
  flex-shrink: 0;
}

.bar-line .bar-track {
  margin: 0 16rpx;
}

.bar-line .bar-rate {
  width: 68rpx;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 28rpx;
  color: #1C1C1A;
  width: 160rpx;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 8rpx;
  background: #F1EFE8;
  border-radius: 4rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  /* 平滑过渡：数字与条形同时动 */
  transition: width 0.5s ease;
}

.bar-warn {
  background: #E24B4A;
}

.bar-strong {
  background: #0F6E56;
}

.item-rate {
  font-size: 26rpx;
  color: #5F5E5A;
  width: 72rpx;
  text-align: right;
  flex-shrink: 0;
}

.scene-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.scene-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #BA7517;
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.scene-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.5;
}

.pattern {
  background: #F4F3EF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.pattern-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.7;
}

.disclaimer {
  font-size: 22rpx;
  color: #B4B2A9;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.stats {
  margin-bottom: 40rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #8B8A85;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary {
  background: #1C1C1A;
  color: #FCFCFA;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
  border: none;
}

.btn-secondary {
  background: transparent;
  color: #1C1C1A;
  border: 1rpx solid rgba(28, 28, 26, 0.2);
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
}

.btn-ghost {
  background: transparent;
  color: #8B8A85;
  border: none;
  font-size: 26rpx;
  padding: 16rpx;
}

.hint-line {
  text-align: center;
  font-size: 24rpx;
  color: #B4B2A9;
  margin-top: 24rpx;
}

/* 合规分享按钮 */
.share-btn {
  margin-top: 24rpx;
  background: transparent;
  border: 1rpx solid rgba(28, 28, 26, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  width: 100%;
}

.share-btn::after {
  border: none;
}

.share-btn-text {
  font-size: 26rpx;
  color: #1C1C1A;
}