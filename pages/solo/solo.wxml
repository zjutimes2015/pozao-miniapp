<view class="page">
  <!-- 关卡选择条 -->
  <scroll-view class="levels" scroll-x="{{true}}">
    <view class="level-chip {{currentLevelId === item.id ? 'chip-active' : ''}} {{item.unlocked ? '' : 'chip-locked'}}"
          wx:for="{{levels}}" wx:key="id">
      <text class="chip-num">{{item.id}}</text>
      <text class="chip-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <view class="progress-bar" wx:if="{{currentQuestion}}">
    <text class="progress-text">{{progressText}}</text>
    <text class="progress-count">{{answeredCount}}</text>
  </view>

  <view class="scene" wx:if="{{question}}">
    <view class="scene-tag">{{currentLevel.name}}</view>

    <view class="text-block">{{question.text}}</view>

    <view class="cards">
      <view
        wx:for="{{cards}}"
        wx:key="id"
        class="card card-{{item.type}} {{selectedFrom === item.id ? 'card-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <view class="card-type">{{item.type === 'premise' ? '前提' : '结论'}}</view>
        <view class="card-text">{{item.text}}</view>
      </view>
    </view>

    <view class="tip" wx:if="{{!submitted}}">
      <text class="tip-text">点一张前提卡，然后选出这句话的问题所在</text>
    </view>

    <view class="options" wx:if="{{!submitted}}">
      <view
        wx:for="{{fallacyOptions}}"
        wx:key="key"
        class="option {{selectedFallacy === item.key ? 'option-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onFallacyTap"
      >
        <text class="option-name">{{item.name}}</text>
        <text class="option-group">{{item.group}}</text>
      </view>
    </view>

    <view class="submit-row" wx:if="{{!submitted}}">
      <button
        class="btn-primary {{selectedFrom && selectedFallacy ? '' : 'btn-disabled'}}"
        bindtap="onSubmit"
      >看结果</button>
    </view>

    <!-- 结果区：正面言语反馈，禁止积分诱导 -->
    <view class="feedback" wx:if="{{submitted}}">
      <view class="feedback-head {{result.correct ? 'head-right' : 'head-redirect'}}">
        {{result.correct ? '抓到了' : '断点找错了'}}
      </view>
      <view class="feedback-text">{{feedback.text}}</view>

      <view class="truth" wx:if="{{!result.correct}}">
        <view class="truth-label">正确断点</view>
        <view class="truth-text">{{question.groundTruth}}</view>
      </view>

      <view class="hint-row" wx:if="{{question.hint}}">
        <text class="hint-label">提示</text>
        <text class="hint-text">{{question.hint}}</text>
      </view>

      <button class="btn-primary btn-next" bindtap="onNext">
        {{currentQuestionIndex + 1 < 3 ? '下一题' : (currentLevelId < 5 ? '下一关' : '看我的指纹')}}
      </button>
    </view>
  </view>

  <view class="exit" bindtap="onExit">退出本轮</view>

  <!-- 合规分享入口：原生转发按钮，不设奖励、不解锁内容（3.2.1） -->
  <button class="share-btn" open-type="share">
    <text class="share-btn-text">把题目发给朋友 ›</text>
  </button>
</view>