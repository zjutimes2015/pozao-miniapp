.page {
  min-height: 100vh;
  background: #FCFCFA;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* 极简克制：字号统一、留白充分、两个主色 */
.progress-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #5F5E5A;
}

.progress-count {
  font-size: 26rpx;
  color: #8B8A85;
}

.scene-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.scene-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #1D9E75;
  border: 1rpx solid rgba(29, 158, 117, 0.3);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.scene-hint {
  font-size: 24rpx;
  color: #8B8A85;
}

.text-block {
  font-size: 36rpx;
  line-height: 1.6;
  color: #1C1C1A;
  margin-bottom: 48rpx;
}

.cards {
  margin-bottom: 40rpx;
}

.card {
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: border-color 0.2s, background 0.2s;
}

.card-active {
  border-color: #185FA5;
  background: #E6F1FB;
}

.card-type {
  font-size: 20rpx;
  color: #8B8A85;
  margin-bottom: 8rpx;
}

.card-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.5;
}

.tip {
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8B8A85;
}

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.option {
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.option-active {
  border-color: #1C1C1A;
  background: #1C1C1A;
}

.option-active .option-name,
.option-active .option-group {
  color: #FCFCFA;
}

.option-name {
  font-size: 26rpx;
  color: #1C1C1A;
}

.option-group {
  font-size: 20rpx;
  color: #8B8A85;
}

.submit-row {
  margin-bottom: 32rpx;
}

.btn-primary {
  background: #1C1C1A;
  color: #FCFCFA;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
  width: 100%;
  border: none;
}

.btn-disabled {
  opacity: 0.3;
}

.feedback {
  border-top: 1rpx solid rgba(28, 28, 26, 0.1);
  padding-top: 40rpx;
}

.feedback-head {
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.head-right {
  color: #0F6E56;
}

.head-redirect {
  color: #854F0B;
}

.feedback-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.truth {
  background: #F4F3EF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.truth-label {
  font-size: 22rpx;
  color: #8B8A85;
  margin-bottom: 10rpx;
}

.truth-text {
  font-size: 26rpx;
  color: #1C1C1A;
  line-height: 1.6;
}

.hint-row {
  margin-bottom: 32rpx;
}

.hint-label {
  font-size: 22rpx;
  color: #8B8A85;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #5F5E5A;
}

.btn-next {
  margin-top: 16rpx;
}

.exit {
  text-align: center;
  font-size: 24rpx;
  color: #B4B2A9;
  margin-top: 48rpx;
}

/* 关卡选择条 */
.levels {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.level-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
}

.chip-active {
  border-color: #1C1C1A;
  background: #1C1C1A;
}

.chip-locked {
  opacity: 0.35;
}

.chip-num {
  font-size: 20rpx;
  color: #8B8A85;
}

.chip-name {
  font-size: 24rpx;
  color: #1C1C1A;
  white-space: nowrap;
}

.chip-active .chip-num,
.chip-active .chip-name {
  color: #FCFCFA;
}

/* 合规分享按钮 */
.share-btn {
  margin-top: 32rpx;
  background: transparent;
  border: 1rpx solid rgba(28, 28, 26, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  width: 100%;
}

.share-btn::after {
  border: none;
}

.share-btn-text {
  font-size: 26rpx;
  color: #1C1C1A;
}