<view class="page">
  <!-- 训练模式切换（v2.1：三个模式，ARG 仅此处可见） -->
  <view class="mode-switch">
    <view class="mode {{trainingMode === 'daily' ? 'mode-active' : ''}}" bindtap="onStartMode">
      <text class="mode-text">每日三题</text>
    </view>
    <view class="mode {{trainingMode === 'arg' ? 'mode-active' : ''}}" bindtap="onSwitchArg">
      <text class="mode-text">论证质量</text>
    </view>
    <view class="mode {{trainingMode === 'troll' ? 'mode-active' : ''}}" bindtap="onSwitchTroll">
      <text class="mode-text">怎么回</text>
    </view>
  </view>

  <!-- 今日概览 -->
  <view class="header" wx:if="{{trainingMode === 'daily'}}">
    <view class="today-row">
      <text class="today-label">今日</text>
      <text class="today-count">{{todayDone}} / {{todayTarget}}</text>
    </view>
    <view class="streak-row">
      <text class="streak-num">{{streak}}</text>
      <text class="streak-label">天连续</text>
      <text class="streak-safe" wx:if="{{streakProtected}}">·漏一天不影响，继续就恢复</text>
    </view>
  </view>

  <!-- 训练入口 -->
  <view class="start-card" wx:if="{{!started && todayDone < todayTarget}}">
    <text class="start-title">今日三题</text>
    <text class="start-desc">优先练你最容易掉进去的那几类。三题大约两分钟。</text>
    <button class="btn-primary" bindtap="onStart">开始</button>
  </view>

  <view class="done-card" wx:if="{{!started && todayDone >= todayTarget}}">
    <text class="done-text">今天的三题已完成。</text>
    <text class="done-sub">明天再来，或者去闯新的关卡。</text>
  </view>

  <!-- 答题区 -->
  <view wx:if="{{started && currentQuestion}}">
    <view class="progress-row">
      <text class="progress-text">第 {{currentIndex + 1}} / {{todayTarget}} 题</text>
    </view>

    <view class="text-block">{{currentQuestion.text}}</view>

    <view class="cards">
      <view
        wx:for="{{currentQuestion.cards}}"
        wx:key="id"
        class="card {{selectedFrom === item.id ? 'card-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <view class="card-type">{{item.type === 'premise' ? '前提' : '结论'}}</view>
        <view class="card-text">{{item.text}}</view>
      </view>
    </view>

    <view class="options" wx:if="{{!submitted}}">
      <view
        wx:for="{{fallacyOptions}}"
        wx:key="key"
        class="option {{selectedFallacy === item.key ? 'option-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onFallacyTap"
      >
        <text class="option-name">{{item.name}}</text>
        <text class="option-group">{{item.group}}</text>
      </view>
    </view>

    <view class="weak-hint" wx:if="{{!submitted}}">
      <text class="weak-hint-label">这题练的是</text>
      <text class="weak-hint-name">{{currentQuestion.scene}}</text>
    </view>

    <button wx:if="{{!submitted}}" class="btn-primary {{selectedFrom && selectedFallacy ? '' : 'btn-disabled'}}" bindtap="onSubmit">提交</button>

    <view class="feedback" wx:if="{{submitted}}">
      <view class="feedback-text">{{feedback.text}}</view>
      <view class="truth" wx:if="{{!result.correct}}">
        <view class="truth-text">{{currentQuestion.groundTruth}}</view>
      </view>
      <button class="btn-primary" bindtap="onNext">
        {{currentIndex + 1 < todayTarget ? '下一题' : '完成'}}
      </button>
    </view>
  </view>

  <!-- 能力概览：不做进度条，只做刻度列表 -->
  <view class="section" wx:if="{{trainingMode === 'daily' && !started && weakList.length}}">
    <text class="section-title">当前短板</text>
    <view class="item" wx:for="{{weakList}}" wx:key="name">
      <text class="item-name">{{item.name}}</text>
      <view class="bar-track">
        <view class="bar-fill bar-warn" style="width: {{item.rate}}%"></view>
      </view>
      <text class="item-rate">{{item.rate}}%</text>
    </view>
  </view>

  <view class="section" wx:if="{{trainingMode === 'daily' && !started && strongList.length}}">
    <text class="section-title">当前强项</text>
    <view class="item" wx:for="{{strongList}}" wx:key="name">
      <text class="item-name">{{item.name}}</text>
      <view class="bar-track">
        <view class="bar-fill bar-strong" style="width: {{item.rate}}%"></view>
      </view>
      <text class="item-rate">{{item.rate}}%</text>
    </view>
  </view>

  <view class="pattern" wx:if="{{trainingMode === 'daily' && !started && pattern}}">
    <text class="pattern-text">{{pattern}}</text>
  </view>

  <!-- ========== v2.1 ARG 论证质量模块（仅训练层与月测） ========== -->
  <view wx:if="{{trainingMode === 'arg' && argItem}}">
    <view class="module-tag">论证质量 · 三关</view>

    <view class="arg-scene">{{argItem.scene}}</view>

    <view class="arg-block">
      <view class="arg-label">理由</view>
      <view class="arg-text">{{argItem.premise}}</view>
    </view>
    <view class="arg-block">
      <view class="arg-label">结论</view>
      <view class="arg-text">{{argItem.conclusion}}</view>
    </view>

    <view class="tip">
      <text class="tip-text">这个论证在哪一关没过去？</text>
    </view>

    <view class="options" wx:if="{{!argResult}}">
      <view
        wx:for="{{argOptions}}"
        wx:key="key"
        class="option {{argPick === item.key ? 'option-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onArgPick"
      >
        <text class="option-key">{{item.key}}</text>
        <view class="option-body">
          <text class="option-name">{{item.name}}</text>
          <text class="option-desc">{{item.question}}</text>
        </view>
      </view>
    </view>

    <button wx:if="{{!argResult}}" class="btn-primary {{argPick ? '' : 'btn-disabled'}}" bindtap="onArgSubmit">看判定</button>

    <view class="feedback" wx:if="{{argResult}}">
      <view class="feedback-head {{argResult.correct ? 'head-right' : 'head-redirect'}}">
        {{argResult.correct ? '判断正确' : '这一关是' + argResult.expectedName}}
      </view>
      <view class="feedback-text">{{argResult.feedback.text}}</view>

      <view class="hidden-premise" wx:if="{{argResult.hiddenPremise}}">
        <view class="truth-label">被藏起来的理由</view>
        <view class="truth-text">{{argResult.hiddenPremise}}</view>
      </view>

      <view class="arg-detail">
        <text class="arg-detail-text">{{argResult.feedback.hint}}</text>
      </view>

      <button class="btn-secondary" bindtap="onSwitchArg">换一题</button>
      <button class="btn-ghost" bindtap="onArgSelfCheck">自检我的说法</button>
    </view>
  </view>

  <!-- ========== v2.1 杠精应对模块 ========== -->
  <view wx:if="{{trainingMode === 'troll' && trollItem}}">
    <view class="module-tag">怎么回 · 筛查四关</view>

    <view class="arg-scene">{{trollItem.scene}}</view>

    <view class="dialog">{{trollItem.dialog}}</view>

    <view class="tip">
      <text class="tip-text">对方停在第几关？你该怎么回？</text>
    </view>

    <view class="options" wx:if="{{!trollResult}}">
      <view
        wx:for="{{trollOptions}}"
        wx:key="key"
        class="option {{trollPick === item.key ? 'option-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTrollPick"
      >
        <text class="option-name">{{item.name}}</text>
        <text class="option-desc">{{item.desc}}</text>
      </view>
    </view>

    <button wx:if="{{!trollResult}}" class="btn-primary {{trollPick ? '' : 'btn-disabled'}}" bindtap="onTrollSubmit">看建议</button>

    <view class="feedback" wx:if="{{trollResult}}">
      <view class="feedback-head {{trollResult.correct ? 'head-right' : 'head-redirect'}}">
        {{trollResult.correct ? '应对正确' : '停在第' + trollResult.stopAt + '关：' + trollResult.stopName}}
      </view>
      <view class="feedback-text">{{trollResult.why}}</view>

      <view class="strategy-list" wx:if="{{trollResult.response.strategies.length}}">
        <view class="strategy" wx:for="{{trollResult.response.strategies}}" wx:key="key">
          <text class="strategy-name">{{item.name}}</text>
          <text class="strategy-desc">{{item.desc}}</text>
          <view class="strategy-template" wx:if="{{item.template}}">
            <text>{{item.template}}</text>
          </view>
          <view class="strategy-steps" wx:if="{{item.steps}}">
            <view class="step" wx:for="{{item.steps}}" wx:for-item="s" wx:key="step">
              <text class="step-num">{{s.step}}</text>
              <text class="step-text">{{s.example}}</text>
            </view>
          </view>
        </view>
      </view>

      <button class="btn-secondary" bindtap="onSwitchTroll">换一段</button>
    </view>
  </view>
</view>