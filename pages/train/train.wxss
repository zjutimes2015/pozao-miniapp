.page {
  min-height: 100vh;
  background: #FCFCFA;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.today-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.today-label {
  font-size: 26rpx;
  color: #5F5E5A;
}

.today-count {
  font-size: 36rpx;
  color: #1C1C1A;
}

.streak-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.streak-num {
  font-size: 56rpx;
  color: #1C1C1A;
}

.streak-label {
  font-size: 26rpx;
  color: #5F5E5A;
}

.streak-safe {
  font-size: 22rpx;
  color: #0F6E56;
}

.start-card {
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.start-title {
  font-size: 32rpx;
  color: #1C1C1A;
  display: block;
  margin-bottom: 12rpx;
}

.start-desc {
  font-size: 26rpx;
  color: #5F5E5A;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.done-card {
  background: #E1F5EE;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.done-text {
  font-size: 30rpx;
  color: #0F6E56;
  display: block;
  margin-bottom: 8rpx;
}

.done-sub {
  font-size: 24rpx;
  color: #0F6E56;
}

.progress-row {
  margin-bottom: 32rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #8B8A85;
}

.text-block {
  font-size: 34rpx;
  line-height: 1.6;
  color: #1C1C1A;
  margin-bottom: 40rpx;
}

.cards {
  margin-bottom: 32rpx;
}

.card {
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-active {
  border-color: #185FA5;
  background: #E6F1FB;
}

.card-type {
  font-size: 20rpx;
  color: #8B8A85;
  margin-bottom: 8rpx;
}

.card-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.5;
}

.weak-hint {
  margin-bottom: 24rpx;
}

.weak-hint-label {
  font-size: 22rpx;
  color: #8B8A85;
  margin-right: 12rpx;
}

.weak-hint-name {
  font-size: 22rpx;
  color: #185FA5;
}

/* 谬误选项 */
.options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.option {
  border: 1rpx solid rgba(28, 28, 26, 0.12);
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.option-active {
  border-color: #1C1C1A;
  background: #1C1C1A;
}

.option-active .option-name,
.option-active .option-group {
  color: #FCFCFA;
}

.option-name {
  font-size: 26rpx;
  color: #1C1C1A;
}

.option-group {
  font-size: 20rpx;
  color: #8B8A85;
}

.btn-primary {
  background: #1C1C1A;
  color: #FCFCFA;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
  width: 100%;
  border: none;
}

.btn-disabled {
  opacity: 0.3;
}

.feedback {
  margin-top: 32rpx;
}

.feedback-text {
  font-size: 28rpx;
  color: #1C1C1A;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.truth {
  border-left: 3rpx solid #185FA5;
  padding-left: 24rpx;
  margin-bottom: 24rpx;
}

.truth-text {
  font-size: 26rpx;
  color: #5F5E5A;
  line-height: 1.6;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 26rpx;
  color: #5F5E5A;
  display: block;
  margin-bottom: 24rpx;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 28rpx;
  color: #1C1C1A;
  width: 160rpx;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 8rpx;
  background: #F1EFE8;
  border-radius: 4rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.bar-warn {
  background: #E24B4A;
}

.bar-strong {
  background: #0F6E56;
}

.item-rate {
  font-size: 26rpx;
  color: #5F5E5A;
  width: 72rpx;
  text-align: right;
  flex-shrink: 0;
}

.pattern {
  background: #F4F3EF;
  border-radius: 16rpx;
  padding: 32rpx;
}

.pattern-text {
  font-size: 26rpx;
  color: #1C1C1A;
  line-height: 1.7;
}